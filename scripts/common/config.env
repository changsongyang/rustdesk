# RustDesk 环境配置文件
# 此文件用于存储环境特定的配置
# 请根据实际环境修改以下配置

# 项目路径配置
PROJECT_HOME=/opt/rustdesk
DATA_DIR=${PROJECT_HOME}/data
LOG_DIR=${PROJECT_HOME}/logs
CONFIG_DIR=${PROJECT_HOME}/config
BACKUP_DIR=${PROJECT_HOME}/backups

# RustDesk 服务端口配置
HBBDS_PORT=21115
HBBDS_TLS_PORT=21116
RELAY_PORT=21117
NAT_TYPE_TEST_PORT=21118
STATUS_PORT=21119
HEALTH_CHECK_PORT=21120

# Docker 配置
DOCKER_IMAGE=rustdesk/rustdesk-server
DOCKER_COMPOSE_FILE=docker-compose.yml
DOCKER_NETWORK=rustdesk-net

# Kubernetes 配置
K8S_NAMESPACE=rustdesk
K8S_DEPLOYMENT_NAME=rustdesk-server
K8S_SERVICE_NAME=rustdesk

# 数据库配置 (可选)
# ENABLE_DATABASE=true
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=rustdesk
# POSTGRES_USER=rustdesk
# POSTGRES_PASSWORD=your_secure_password

# Redis 配置 (可选)
# ENABLE_REDIS=true
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# 安全配置
ENABLE_TLS=true
ENABLE_AUTH=true
ENCRYPTION_METHOD=aes-256-gcm

# 日志配置
LOG_LEVEL=info
LOG_MAX_SIZE=100M
LOG_MAX_AGE=30
LOG_MAX_BACKUPS=7

# 备份配置
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION=true
BACKUP_COMPRESSION=gzip
REMOTE_BACKUP_ENABLED=false
# REMOTE_BACKUP_URL=s3://your-bucket/backups

# 性能配置
MAX_CONNECTIONS=1000
WORKER_THREADS=4
MEMORY_LIMIT=2G
CPU_LIMIT=2

# 超时配置 (秒)
CONNECTION_TIMEOUT=30
HEALTH_CHECK_INTERVAL=60
STARTUP_TIMEOUT=300

# 镜像源配置 (中国用户可启用)
# DOCKER_MIRROR=https://mirror.ccs.tencentyun.com
# CARGO_MIRROR=https://rsproxy.cn
# GITHUB_MIRROR=https://mirror.ghproxy.com

# 通知配置
ENABLE_NOTIFICATIONS=false
# NOTIFICATION_WEBHOOK=https://your-webhook.com/notify
# EMAIL_ALERT=admin@example.com

# 监控配置
ENABLE_METRICS=false
METRICS_PORT=9090
PROMETHEUS_ENABLED=false
GRAFANA_ENABLED=false

# 系统要求
MIN_CPU_CORES=2
MIN_MEMORY_GB=2
MIN_DISK_SPACE_GB=10

# 语言设置 (en/zh)
LANG=en

# 部署模式 (docker/kubernetes/source)
DEPLOY_MODE=docker
