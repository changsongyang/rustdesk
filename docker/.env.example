# ============================================================
# RustDesk Docker Environment Configuration
# RustDesk Docker 环境配置模板
# ============================================================
#
# Copy this file to .env and configure for your environment
# 复制此文件到 .env 并配置您的环境
#
# Usage / 使用方法:
#   cp .env.example .env
#   vim .env
#   docker-compose up -d
#
# ============================================================

# ============================================================
# 基础配置 / Base Configuration
# ============================================================

# RustDesk 镜像地址 / RustDesk image repository
RUSTDESK_IMAGE=rustdesk/rustdesk-server

# RustDesk 版本标签 / RustDesk version tag
# 推荐使用固定版本而非 latest / Recommend using fixed version instead of latest
RUSTDESK_TAG=latest

# 部署环境 / Deployment environment
DEPLOYMENT_ENV=production

# 时区配置 / Timezone configuration
TZ=Asia/Shanghai

# 重启策略 / Restart policy
# 选项: no, always, on-failure, unless-stopped
RESTART_POLICY=unless-stopped

# ============================================================
# 服务端口配置 / Service Port Configuration
# ============================================================

# hbbs 信号服务器端口 / hbbs signaling server port
HBBS_PORT=21115

# hbbs NAT 穿透端口 / hbbs NAT detection port
HBBS_NAT_PORT=21117

# hbbr 中继服务器端口 / hbbr relay server port
HBBR_PORT=21116

# Nginx HTTP/HTTPS 端口 / Nginx HTTP/HTTPS ports
HTTP_PORT=80
HTTPS_PORT=443

# ============================================================
# 服务副本数配置 / Service Replicas Configuration (Swarm Only)
# ============================================================

# hbbs 副本数 / hbbs replicas
HBBS_REPLICAS=1

# hbbr 副本数 / hbbr replicas
HBBR_REPLICAS=2

# Nginx 副本数 / nginx replicas
NGINX_REPLICAS=1

# ============================================================
# 资源限制配置 / Resource Limits Configuration
# ============================================================

# hbbs 资源限制 / hbbs resource limits
HBBS_CPU_LIMIT=1.0
HBBS_MEMORY_LIMIT=512M
HBBS_CPU_RESERVE=0.5
HBBS_MEMORY_RESERVE=256M

# hbbr 资源限制 / hbbr resource limits
HBBR_CPU_LIMIT=2.0
HBBR_MEMORY_LIMIT=1024M
HBBR_CPU_RESERVE=1.0
HBBR_MEMORY_RESERVE=512M

# Nginx 资源限制 / nginx resource limits
NGINX_CPU_LIMIT=0.5
NGINX_MEMORY_LIMIT=256M
NGINX_CPU_RESERVE=0.1
NGINX_MEMORY_RESERVE=64M

# Nginx Worker 配置 / Nginx Worker Configuration
NGINX_WORKER_PROCESSES=auto
NGINX_WORKER_CONNECTIONS=2048

# ============================================================
# 日志配置 / Logging Configuration
# ============================================================

# 单个日志文件最大大小 / Maximum size of single log file
LOG_MAX_SIZE=10m

# 日志文件最大数量 / Maximum number of log files
LOG_MAX_FILES=5

# ============================================================
# 网络配置 / Network Configuration
# ============================================================

# 网络驱动 / Network driver
# Docker Compose: bridge, host, none
# Docker Swarm: overlay
NETWORK_DRIVER=bridge

# Docker Compose 网络子网 / Docker Compose network subnet
NETWORK_SUBNET=172.28.0.0/16
NETWORK_GATEWAY=172.28.0.1

# Docker Swarm Overlay 网络配置 / Docker Swarm overlay network config
OVERLAY_SUBNET=172.29.0.0/16
OVERLAY_GATEWAY=172.29.0.1

# 启用 IPv6 / Enable IPv6
NETWORK_IPV6=false

# ============================================================
# 目录路径配置 / Directory Path Configuration
# ============================================================

# 数据目录 / Data directory
DATA_DIR=./data

# 配置文件目录 / Configuration directory
CONFIG_DIR=./config

# 日志目录 / Log directory
LOG_DIR=./logs

# Nginx 配置目录 / Nginx configuration directory
NGINX_CONF_DIR=./nginx

# SSL 证书目录 / SSL certificates directory
NGINX_CERTS_DIR=./certs

# ============================================================
# Nginx 镜像配置 / Nginx Image Configuration
# ============================================================

# Nginx 镜像 / Nginx image
NGINX_IMAGE=nginx

# Nginx 标签 / Nginx tag
NGINX_TAG=alpine

# ============================================================
# hbbs 配置 / hbbs Configuration
# ============================================================

# 日志级别 / Log level
# 选项: error, warn, info, debug, trace
RUST_LOG=info

# 只允许加密连接 / Only allow encrypted connections
HBBS_ENCRYPTED_ONLY=false

# 允许断开连接 / Allow disconnect
HBBS_ALLOW_DISCONNECT=true

# ============================================================
# hbbr 配置 / hbbr Configuration
# ============================================================

# 最大连接数 / Maximum connections
HBBR_MAX_CONNECTION=4096

# 允许断开连接 / Allow disconnect
HBBR_ALLOW_DISCONNECT=true

# ============================================================
# 安全配置 / Security Configuration
# ============================================================

# Docker Registry 认证 / Docker Registry authentication
# REGISTRY_AUTH=basic
# REGISTRY_USER=your-username
# REGISTRY_PASS=your-password

# SSL 证书路径 / SSL certificate paths
# SSL_CERT_PATH=/path/to/fullchain.pem
# SSL_KEY_PATH=/path/to/privkey.pem

# ============================================================
# 备份配置 / Backup Configuration
# ============================================================

# 备份目录 / Backup directory
BACKUP_DIR=./backups

# 备份保留天数 / Backup retention days
BACKUP_RETENTION_DAYS=30

# ============================================================
# 监控配置 / Monitoring Configuration
# ============================================================

# 启用监控 / Enable monitoring
ENABLE_MONITORING=true

# Prometheus 端口 / Prometheus port
PROMETHEUS_PORT=9090

# Grafana 端口 / Grafana port
GRAFANA_PORT=3000

# ============================================================
# 生产环境推荐配置 / Production Recommended Configuration
# ============================================================

# 生产环境应该使用固定版本 / Production should use fixed version
# RUSTDESK_TAG=1.2.3

# 生产环境应该设置资源限制 / Production should set resource limits
# HBBS_CPU_LIMIT=2.0
# HBBS_MEMORY_LIMIT=1G
# HBBR_CPU_LIMIT=4.0
# HBBR_MEMORY_LIMIT=2G

# 生产环境应该配置日志轮转 / Production should configure log rotation
# LOG_MAX_SIZE=50m
# LOG_MAX_FILES=10

# ============================================================
# 开发和测试配置 / Development and Testing Configuration
# ============================================================

# 开发环境 / Development environment
# DEPLOYMENT_ENV=development
# RUST_LOG=debug
# HBBS_REPLICAS=1
# HBBR_REPLICAS=1
# LOG_MAX_SIZE=5m
# LOG_MAX_FILES=3

# 测试环境 / Testing environment
# DEPLOYMENT_ENV=testing
# RUST_LOG=debug
# RESTART_POLICY=no
