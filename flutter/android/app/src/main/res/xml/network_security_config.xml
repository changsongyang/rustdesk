&lt;?xml version="1.0" encoding="utf-8"?&gt;
&lt;network-security-config&gt;
    &lt;!-- 基础配置：生产环境默认禁用明文流量，强制TLSv1.2+ --&gt;
    &lt;base-config cleartextTrafficPermitted="false"&gt;
        &lt;trust-anchors&gt;
            &lt;!-- 仅信任系统 CA，移除用户 CA 以防止中间人攻击 --&gt;
            &lt;certificates src="system" /&gt;
        &lt;/trust-anchors&gt;
        &lt;versions&gt;
            &lt;version&gt;TLSv1.3&lt;/version&gt;
            &lt;version&gt;TLSv1.2&lt;/version&gt;
        &lt;/versions&gt;
    &lt;/base-config&gt;

    &lt;!-- HSTS配置：强制使用HTTPS --&gt;
    &lt;domain-config cleartextTrafficPermitted="false"&gt;
        &lt;domain includeSubdomains="true"&gt;ycsit.cn&lt;/domain&gt;
        &lt;domain includeSubdomains="true"&gt;rustdesk.ycsit.cn&lt;/domain&gt;

        &lt;trust-anchors&gt;
            &lt;certificates src="system" /&gt;
        &lt;/trust-anchors&gt;

        &lt;hsts includeSubdomains="true" maxAge="31536000" /&gt;
    &lt;/domain-config&gt;

    &lt;!-- 调试配置：仅在DEBUG模式下允许用户 CA --&gt;
    &lt;debug-overrides&gt;
        &lt;trust-anchors&gt;
            &lt;certificates src="system" /&gt;
            &lt;certificates src="user" /&gt;
        &lt;/trust-anchors&gt;
    &lt;/debug-overrides&gt;
&lt;/network-security-config&gt;
